  "torsion_certificate": {
    "argument": "At the good primes 11 and 59 the group orders are 18 and 73. A rational torsion point of prime order ell injects at good reduction primes away from ell. If ell is neither 11 nor 59, then ell divides gcd(18,73)=1. The cases ell=11 and ell=59 are excluded by reduction at 59 and 11 respectively.",
    "conclusion": "E(Q)_tors is trivial",
    "reductions": [
      {
        "group_order": 18,
        "prime": 11
      },
      {
        "group_order": 73,
        "prime": 59
      }
    ]
  }
